# Cell 1: Introduction
"""
# Exploring the Riemann Hypothesis

This notebook provides an interactive exploration of the Riemann Hypothesis.
We'll compute non-trivial zeros, visualize the zeta function, and explore prime number distributions.
"""

# Cell 2: Import Libraries
import numpy as np
import matplotlib.pyplot as plt
from mpmath import zetazero, zeta
from utils.zeta_utils import compute_zeros
from utils.plot_utils import set_plot_style

set_plot_style()

# Cell 3: Compute and Plot Zeros
num_zeros = 10
zeros = compute_zeros(num_zeros)
plt.scatter([0.5]*len(zeros), zeros, color="orange", label="Non-Trivial Zeros")
plt.xlabel("Re(s)")
plt.ylabel("Im(s)")
plt.title(f"First {num_zeros} Non-Trivial Zeros on the Critical Line")
plt.legend()
plt.show()

# Cell 4: Visualize Zeta Function Magnitude
sigma_range = np.linspace(0, 1, 50)
t_range = np.linspace(0, 30, 50)
S, T = np.meshgrid(sigma_range, t_range)
Z = np.zeros_like(S, dtype=complex)
for i in range(S.shape[0]):
    for j in range(S.shape[1]):
        Z[i, j] = zeta(S[i, j] + 1j * T[i, j])
plt.contourf(S, T, np.abs(Z), levels=50, cmap="viridis")
plt.colorbar(label="|ζ(s)|")
plt.xlabel("σ")
plt.ylabel("t")
plt.title("Magnitude of ζ(s) in the Critical Strip")
plt.show()
